# SecureMed — Docker Compose Environment File
# انسخ هذا إلى backend/.env.docker واملأ القيم قبل تشغيل docker compose.
# Copy to backend/.env.docker and fill values before `docker compose up`.
# Do NOT commit .env.docker with real values.

# ---------- Core ----------
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-secrets.token_urlsafe64
# Comma-separated. NEVER use '*' in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Database ----------
# Compose topology: the bundled Postgres service. For a managed database,
# point DATABASE_URL at it instead.
DATABASE_URL=postgres://postgres:replace-me@db:5432/securemed
POSTGRES_PASSWORD=replace-me

# ---------- Redis (cache + Celery broker + channels layer) ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
USE_REDIS_CACHE=True
CACHE_URL=redis://redis:6379/0

# ---------- Field Encryption (Fernet for columns, AES-256-GCM for files) ----------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me-with-Fernet.generate_key

# ---------- Audit log HMAC ----------
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUDIT_LOG_HMAC_KEY=replace-me-with-secrets.token_urlsafe64

# ---------- Origin (SPA + API are the same origin under one Dockerfile) ----------
# No CORS list needed for the SPA itself; set CSRF_TRUSTED_ORIGINS to the
# public URL the browser uses.
CSRF_TRUSTED_ORIGINS=https://securemed.example.com
# Used in password-reset/invitation emails.
FRONTEND_URL=https://securemed.example.com

# ---------- Reverse proxy ----------
# One trusted proxy hop (the nginx "tls" profile, or your external LB).
TRUST_X_FORWARDED_FOR=True
TRUSTED_PROXY_COUNT=1

# ---------- TURN (video calls over NAT/firewalls) ----------
# Shared HMAC secret between the backend (rtc-config endpoint) and the
# coturn container. Generate with: openssl rand -base64 32
TURN_STATIC_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
# Public host/IP clients reach coturn on (the VPS address or a turn.* DNS
# name). Used to build the iceServers URIs.
TURN_PUBLIC_HOST=replace-me-with-vps-host-or-dns
TURN_PORT=3478
TURN_TLS_PORT=5349

# ---------- Payments (Moyasar; sandbox by default) ----------
# PAYMENT_GATEWAY=moyasar|sandbox — sandbox is the safe default for staging.
PAYMENT_GATEWAY=sandbox
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# Webhook signing secret from the Moyasar dashboard; verifies callback
# signatures before any invoice state changes.
MOYASAR_WEBHOOK_SECRET=

# ---------- FCM push notifications (Android + Web) ----------
# Both must be set for push delivery to activate. FCM_SERVICE_ACCOUNT_JSON is
# the full service-account JSON (single line or base64).
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ---------- AI (optional) ----------
GEMINI_API_KEY=

# ---------- Telegram (device approval / backup delivery, optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Initial superuser ----------
# Leave INITIAL_ADMIN_PASSWORD empty to have setup.sh generate one and print it once.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@securemed.app
INITIAL_ADMIN_PASSWORD=

# ---------- Demo data ----------
# Set to 0 in production. SEED_DEMO_DATA seeds 10 well-known passwords
# (admin@securemed.app / Admin@2026!, doctor.* / Doctor@2026!, etc.) — never
# run on a deployment that real users can reach.
SEED_DEMO_DATA=0

# ---------- Observability ----------
# Grafana admin password (profile "observe").
GF_SECURITY_ADMIN_PASSWORD=replace-me

LOG_LEVEL=INFO
