# SecureMed — Backend Environment File
# نسخ هذا الملف إلى .env وتعديل القيم
# Copy this file to .env and adjust values.

# ---------- Core ----------
DJANGO_SETTINGS_MODULE=config.settings        # config.dev_settings للتطوير المحلي بدون PostgreSQL
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ---------- Database (اختر طريقة واحدة) ----------
# 1) سحابي (Neon / Render PostgreSQL) — الأفضل للنشر:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# 2) PostgreSQL ذاتي الإدارة بشهادات mTLS:
# DB_NAME=securemed
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require
# DB_SSL_CLIENT_CERTS=0
# 3) SQLite (عرض تجريبي بدون خادم):
DB_ENGINE=sqlite

# ---------- JWT ----------
# RS256 تلقائياً عند وجود certs/jwt_private.pem، وإلا HS256 بمفتاح SECRET_KEY
# JWT_ALGORITHM=HS256
# JWT_PRIVATE_KEY_PATH=certs/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=certs/jwt_public.pem

# ---------- Field Encryption (AES-256) ----------
# Generate with: python scripts/generate_certificates.py
ENCRYPTION_KEY=securemed-field-encryption-key-32-bytes!!

# مفاتيح تشفير قديمة (الأحدث أولاً، مفصولة بفواصل) — تُستخدم للقراءة فقط.
# تدوير المفتاح: انقل قيمة ENCRYPTION_KEY الحالية إلى بداية هذه القائمة، ثم اضبط
# المفتاح الجديد في ENCRYPTION_KEY وانشر (القراءة تستمر فوراً)، ثم شغّل:
#   python manage.py rotate_encryption_key
# وبعد نجاحه فقط احذف المفتاح القديم من هذه القائمة.
# ENCRYPTION_KEY_FALLBACKS=

# تشفير الملفات المرفوعة على القرص (AES-256-GCM). القيمة الافتراضية: مفعّل عندما
# DEBUG=False. لا يمكن تفعيله مع تقديم /media/ مباشرة من القرص
# (DEBUG=True أو PROTECT_MEDIA_FILES=False) لأن ذلك المسار لا يفكّ التشفير —
# سيرفض التطبيق الإقلاع موضّحاً السبب.
# ENCRYPT_MEDIA_AT_REST=1

# ---------- CORS / CSRF ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# ---------- Frontend URL (روابط استعادة كلمة المرور في البريد) ----------
# في الإنتاج: نفس عنوان الموقع (الواجهة تُقدَّم من Django) مثل https://securemed-web.onrender.com
FRONTEND_URL=http://localhost:3000

# ---------- HTTPS (يُشتق من DEBUG افتراضياً) ----------
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000

# ---------- تحديد موقع عناوين IP عند تسجيل الدخول (GeoIP) ----------
# معطّل افتراضياً. عند تفعيله يُرسل عنوان IP لكل مستخدم يسجّل دخوله إلى خدمة خارجية
# غير تابعة للمنصة، والنتيجة تُستخدم فقط لوسم "موقع جديد" على سجل الجهاز
# (DeviceRegistry). لا تفعّله إلا بعد مراجعة هذا الكشف قانونياً.
# GEOIP_LOOKUP_ENABLED=0
# GEOIP_LOOKUP_URL=https://ip-api.com/json/{ip}

# ---------- AI (المساعد الذكي + الملخصات السريرية) ----------
# يعمل داخل Django عبر google-generativeai — لا توجد خدمة منفصلة.
# بدون هذا المفتاح تعمل بقية المنصة طبيعياً وتُبلّغ نقاط /api/v1/ai/ أنها غير مهيأة.
GEMINI_API_KEY=

# ---------- Email notifications (اختياري — بدونها: console) ----------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=SecureMed <noreply@yourdomain.com>

# ---------- Initial superuser ----------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=SecureMed@2026!
INITIAL_ADMIN_EMAIL=admin@securemed.app

# ---------- AWS S3 Cloud Storage ----------
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_STORAGE_BUCKET_NAME=securemed-bucket
# AWS_S3_REGION_NAME=us-east-1
# USE_S3_STORAGE=0

# ---------- النسخ الاحتياطي: التسليم الخارجي (تلجرام / تخزين سحابي) ----------
# تُنشأ نسخة تلقائية يومياً (2 صباحاً عبر Celery) وتُشفّر Fernet على القرص.
# يمكن إضافة تسليم خارجي للنسخة فور إنشائها بقناتين مستقلتين:

# 1) تلجرام: يُرفع الأرشيف المشفّر إلى شات الإدارة عبر sendDocument.
#    حد Bot API = 50MB للملف الواحد (الأكبر يتجاوز هذه القناة تلقائياً).
#    يتطلب TELEGRAM_BOT_TOKEN + TELEGRAM_ADMIN_CHAT_ID.
# BACKUP_SEND_TO_TELEGRAM=1

# 2) تخزين سحابي متوافق مع S3 (AWS / Cloudflare R2 / Backblaze B2 / MinIO):
#    نسخة ثانية تُرفع للدلو مع SSE. بلا حد حجم.
# BACKUP_OFFSITE_ENABLED=1
# BACKUP_OFFSITE_BUCKET=securemed-backups
# BACKUP_OFFSITE_PREFIX=securemed-backups
# BACKUP_OFFSITE_ENDPOINT_URL=          # ضروري لغير AWS (مثل R2/MinIO)
# BACKUP_OFFSITE_REGION=us-east-1
# مفاتيح مخصّصة للنسخ الاحتياطي (وإلا تُستخدم مفاتيح AWS أعلاه):
# BACKUP_OFFSITE_ACCESS_KEY_ID=
# BACKUP_OFFSITE_SECRET_ACCESS_KEY=

# ---------- بوت تلجرام: تفعيل/إلغاء تفعيل الأجهزة ----------
# طلبات الأجهزة الجديدة تصل لشات الإدارة مع زرّي تفعيل/حظر، ويمكن إلغاء تفعيل
# جهاز موثوق لاحقاً (deactivate) — يُلغى الثقة ويُحظر ويُنهى جلسته فوراً.
# TELEGRAM_WEBHOOK_SECRET إلزامي في الإنتاج (secret_token عند setWebhook).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=

# ---------- APM & Logging (Sentry) ----------
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456

# ---------- Demo seed (تشغيل تلقائي عند الإقلاع على Render) ----------
SEED_DEMO_DATA=1

LOG_LEVEL=INFO
