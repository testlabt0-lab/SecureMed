# =============================================================================
#  SecureMed — Production Environment Variables Template
#  انسخ هذا الملف إلى backend/.env وعدّل القيم
# =============================================================================

# ─── Django Core ──────────────────────────────────────────────────────────────
# يجب أن يكون عشوائياً وطويلاً (50+ حرف) — use: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_64_CHARS_MIN

DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
FRONTEND_URL=https://your-domain.com

# ─── Database (PostgreSQL مُوصى به للإنتاج) ──────────────────────────────────
# Option A: DATABASE_URL (Neon / Render / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/securemed?sslmode=require

# Option B: متغيرات منفصلة (PostgreSQL self-managed)
# DB_ENGINE=postgres
# DB_NAME=securemed
# DB_USER=securemed
# DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require
# DB_SSL_CLIENT_CERTS=false  # ضع true لـ mutual TLS

# ─── Redis (مطلوب لـ Celery والـ Cache) ──────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=django-db

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@your-domain.com
EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
DEFAULT_FROM_EMAIL=SecureMed <noreply@your-domain.com>

# ─── AI Service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai:8100
ZAI_API_KEY=YOUR_Z_AI_API_KEY_HERE

# ─── JWT Tokens ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Security ─────────────────────────────────────────────────────────────────
PASSWORD_RESET_TIMEOUT=3600   # 1 ساعة
CONN_MAX_AGE=600
DB_SSLMODE=require

# ─── Superuser Initial (مرة واحدة فقط عند الإعداد) ──────────────────────────
INITIAL_ADMIN_EMAIL=admin@your-domain.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
INITIAL_ADMIN_USERNAME=admin

# ─── Docker Compose (في ملف .env الجذر، ليس backend/.env) ───────────────────
# POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# DOMAIN=your-domain.com
# BACKEND_PORT=8000
