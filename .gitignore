# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
backend/htmlcov/
backend/.coverage
backend/.pytest_cache/
backend/staticfiles/
backend/logs/
backend/media/
backend/cache/
venv/
.venv/
env/
backend/venv/
*/venv/

# ---------- Environment & secrets (NEVER commit) ----------
.env
**/.env
*.env
*.env.*
.env.production
!.env.example
!.env.production.example
.z-ai-config
**/.z-ai-config
# NOT a blanket `*.txt`: that pattern silently swallowed requirements.txt and any
# future text file that belongs in the repo. Secrets are already covered by the
# .env rules above, so a broad text-file ignore buys nothing and only risks a
# missing dependency manifest on a fresh clone.
*.pptx
*.pdf
comments_mapping.json
extract_comments.py
certs/*.pem
backend/certs/*.pem

# ---------- Local databases ----------
*.sqlite3
*.db

# ---------- Node ----------
node_modules/
frontend/node_modules/
frontend/dist/.vite/

# ---------- Build artifacts ----------
*.zip
*.apk
android/app/build/
android/.gradle/
android/build/
android/local.properties

# ---------- IDE / OS ----------
.vscode/
.idea/
.DS_Store
*.swp
backups/
backend/backups/
SecureMed-main/
