# SecureMed — Docker Compose Environment File
# انسخ هذا إلى .env.docker واملأ القيم قبل تشغيل docker compose.
# لا تقم بوضع قيم إنتاج حقيقية هنا — استخدم docker secrets أو متغيرات بيئة النظام.
# Copy to .env.docker and fill values before `docker compose up`.
# Do NOT commit .env.docker with real values.

# ---------- Core ----------
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-secrets.token_urlsafe64
# Comma-separated. NEVER use '*' in production.
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ---------- Database ----------
# Leave DATABASE_URL empty to use the bundled Postgres profile; set it to a Neon/Render
# URL to use a managed database instead.
DATABASE_URL=postgres://postgres:replace-me@db:5432/securemed

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
USE_REDIS_CACHE=True
CACHE_URL=redis://redis:6379/0

# ---------- Field Encryption (Fernet for columns, AES-256-GCM for files) ----------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me-with-Fernet.generate_key

# ---------- Audit log HMAC ----------
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUDIT_LOG_HMAC_KEY=replace-me-with-secrets.token_urlsafe64

# ---------- CORS / CSRF ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
# CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# ---------- Frontend URL (used in password reset emails) ----------
FRONTEND_URL=http://localhost:3000

# ---------- Reverse proxy ----------
# 1 trusted proxy because nginx sits in front of gunicorn.
TRUST_X_FORWARDED_FOR=True
TRUSTED_PROXY_COUNT=1

# ---------- Initial superuser ----------
# Leave INITIAL_ADMIN_PASSWORD empty to have setup.sh generate one and print it once.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@securemed.app
INITIAL_ADMIN_PASSWORD=

# ---------- AI (optional) ----------
GEMINI_API_KEY=

# ---------- Demo data ----------
# Set to 0 in production. SEED_DEMO_DATA seeds 10 well-known passwords
# (admin@securemed.app / Admin@2026!, doctor.* / Doctor@2026!, etc.) — never
# run on a deployment that real users can reach.
SEED_DEMO_DATA=0

LOG_LEVEL=INFO
