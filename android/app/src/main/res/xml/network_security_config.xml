<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <!-- N11 fix: this must name the host the release build actually calls —
             BuildConfig.API_BASE_URL's release default is
             securemed-web.onrender.com (android/app/build.gradle.kts).
             It previously named securemed-web.onrender.com, so the platform
             never applied these pins to the API host. Any change to
             -PAPI_BASE_URL must update this domain in the same commit. -->
        <domain includeSubdomains="true">securemed-web.onrender.com</domain>
        <!--
            Real SPKI pins for the production backend. Unlike OkHttp's pinner,
            the platform enforces these on every HTTPS connection, so a wrong
            value here is a total outage, not a no-op: the placeholder hashes
            this replaced made every release build unable to reach the server.

            Pinned at the CA level, not the leaf. The leaf (CN=onrender.com)
            is issued by the hosting platform and rotates about every 90 days,
            so pinning it would break the app at the next renewal.

              - Google Trust Services "WE1" intermediate, expires 2029-02-20
              - "GTS Root R4" root,                        expires 2028-01-28

            expiration is the fail-open valve: after this date Android stops
            enforcing the pins, so a CA path change at the host cannot brick
            installs that can no longer be updated. Re-verify the pins and
            move the date forward before it passes — past it, this control is
            silently inactive.

            Re-derive a pin (repeat per certificate in the chain):
              openssl s_client -connect securemed-web.onrender.com:443 \
                -servername securemed-web.onrender.com -showcerts </dev/null \
                | openssl x509 -pubkey -noout \
                | openssl pkey -pubin -outform der \
                | openssl dgst -sha256 -binary | openssl enc -base64

            Keep in sync with NetworkModule.PRODUCTION_PINS.
        -->
        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
        </pin-set>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
