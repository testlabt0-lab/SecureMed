<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biometric permissions -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Alarm & Notification permissions -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        SCHEDULE_EXACT_ALARM vs USE_EXACT_ALARM (Play policy, 4-3):

        USE_EXACT_ALARM is granted without any user action and Play allows it
        only for alarm-clock/calendar-class apps where exactness IS the core
        feature. A medication reminder app is closest to that class but Play's
        published guidance names it as a rejected example unless the dose
        schedule is user-defined (it is here), so the safe submission path is
        SCHEDULE_EXACT_ALARM + a runtime check. ReminderScheduler already
        degrades to an inexact window when canScheduleExactAlarms() is false,
        so a denied grant costs drift, not missing doses. The Play declaration
        form must still be filled (core-functionality justification) and the
        video recorded; the permission alone is not the approval.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Hardware requirements (optional) -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <application
        android:name=".SecureMedApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureMed"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SecureMed.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Re-schedules medication alarms after device reboot.

            LOCKED_BOOT_COMPLETED is deliberately absent: re-arming reads the
            plans from LocalCache (context.filesDir, credential-encrypted), so
            it cannot run before the user unlocks. Claiming that action without
            android:directBootAware="true" only registers a filter the system
            never delivers to.
        -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
            Handles alarm triggers. The class name must stay in sync with
            ReminderScheduler, which targets it explicitly: an unregistered
            receiver means the alarm fires and is dropped, so reminders go
            missing with no error anywhere.
        -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!--
            FCM push. Without google-services.json the Firebase SDK never
            initializes and this service is simply never started — so the
            registration is safe on every build configuration.
        -->
        <service
            android:name=".push.SecureMedPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
